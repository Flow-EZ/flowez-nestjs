{
  "name": "@flow-ez/nestjs",
  "private": true,
  "description": "NestJS integration modules for Redis (ioredis) and MinIO object storage",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "postinstall": "simple-git-hooks",
    "format": "prettier --write .",
    "check": "prettier --check .",
    "lint": "eslint packages --max-warnings=0",
    "build": "pnpm -r --filter=./packages/* run build",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage"
  },
  "keywords": [
    "nestjs",
    "redis",
    "ioredis",
    "minio",
    "object-storage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flow-EZ/flowez-nestjs.git"
  },
  "bugs": {
    "url": "https://github.com/Flow-EZ/flowez-nestjs/issues"
  },
  "homepage": "https://github.com/Flow-EZ/flowez-nestjs#readme",
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.4.1",
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.1",
    "@nestjs/testing": "^12.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "lint-staged": "^17.5.1",
    "picocolors": "^1.1.1",
    "prettier": "3.9.7",
    "release-it": "^19.2.4",
    "release-it-pnpm": "^4.6.6",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.14.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm check",
    "commit-msg": "node scripts/verify-commit.js"
  },
  "lint-staged": {
    "packages/**/*.ts?(x)": [
      "eslint --fix",
      "prettier --parser=typescript --write"
    ]
  },
  "workspaces": [
    "packages/*"
  ]
}
