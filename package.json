{
  "name": "@flowez/nestjs",
  "version": "0.0.2",
  "description": "",
  "main": "index.js",
  "scripts": {
    "postinstall": "simple-git-hooks",
    "format": "prettier --write .",
    "check": "prettier --check .",
    "build": "pnpm -r --filter=./packages/* run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nestjs/testing": "^11.1.19",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.41",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "picocolors": "^1.1.1",
    "prettier": "3.3.3",
    "release-it": "^17.11.0",
    "release-it-pnpm": "^4.6.6",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm check",
    "commit-msg": "node scripts/verify-commit.js"
  },
  "lint-staged": {
    "packages/**/*.ts?(x)": [
      "eslint --fix",
      "prettier --parser=typescript --write"
    ]
  },
  "workspaces": [
    "packages/*"
  ]
}
